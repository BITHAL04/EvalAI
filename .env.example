# ---- Frontend (apps/web/.env.local, or Vercel project settings)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend (apps/api/.env, or Render environment group)
ENVIRONMENT=development
# Runtime connection: the least-privilege evalai_app role, never the owner.
DATABASE_URL=postgresql://evalai_app:CHANGE_ME@HOST:5432/postgres
# Used only by `alembic upgrade head`: the schema owner.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@HOST:5432/postgres

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evalai-private
STORAGE_PROVIDER=supabase   # local is for development and is refused in production

CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
BOOTSTRAP_ADMIN_EMAILS=     # comma separated; these accounts can create institutions

# Pick current ids from https://ai.google.dev/models
# Checked 2026-11: gemini-3.8-flash and gemini-embedding-001 are listed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

APP_SIGNING_SECRET=         # openssl rand -hex 32
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Optional processing configuration
MAX_UPLOAD_SIZE_MB=50
MAX_ANSWER_SHEET_PAGES=80
AI_REQUEST_TIMEOUT=120
AI_RATE_LIMIT_PER_MINUTE=10
OCR_REVIEW_THRESHOLD=0.75
EVALUATION_REVIEW_THRESHOLD=0.7
